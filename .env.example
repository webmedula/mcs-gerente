# mcs-gerente v1 — variaveis de ambiente (copie para .env ou cadastre no EasyPanel)

PORT=3020
# Protege /debug/* deste servico. Sem ela as rotas de diagnostico ficam DESLIGADAS.
SERVICE_API_KEY=

# --- os sistemas da MCS ---
# URL publica de cada servico + a SERVICE_API_KEY DAQUELE servico.
ANALYTICS_BASE_URL=https://SEU-DOMINIO-ANALYTICS
ANALYTICS_API_KEY=
ACTIONS_BASE_URL=https://tiny-ml-actions.zgbjol.easypanel.host
ACTIONS_API_KEY=
NF_BASE_URL=https://SEU-DOMINIO-TINY-PEDIDOS-NF
NF_API_KEY=
# Se o tiny-pedidos-nf tiver DASHBOARD_PASSWORD (senha do painel de vendas), copie o valor aqui. Sem isso,
# vendas do dia e painel voltam 401 mesmo com a NF_API_KEY certa.
NF_DASHBOARD_KEY=
# Central de Ocorrencias: a chave e uma "mcsia_..." criada no painel da Central
# (Chaves do Gerente IA), NAO a SERVICE_API_KEY. Sem estas duas, o Gerente segue sem ocorrencias.
OCORRENCIAS_BASE_URL=https://SEU-DOMINIO-OCORRENCIAS
OCORRENCIAS_API_KEY=
# Backup do Tiny (mcs-backup-tiny 0.9.2+): a chave e a PANEL_API_KEY daquele servico (x-api-key).
# Sem estas duas, o Gerente segue sem o backup.
BACKUP_BASE_URL=https://backup.mcs.ind.br
BACKUP_API_KEY=
# Espera maxima por sistema (ms) e teto do resultado de uma ferramenta enviado ao modelo.
SISTEMA_TIMEOUT_MS=25000
RESULTADO_MAX_CHARS=12000

# --- assistente (copie os MESMOS valores que estao hoje no ml-analytics) ---
# 'anthropic' | 'openrouter'. Vazio = usa a chave que estiver configurada
# (com as duas presentes, fica com o OpenRouter).
ASSISTENTE_PROVEDOR=
# Na Anthropic pode ficar vazio (escolhe um Sonnet). No OpenRouter e OBRIGATORIO.
ASSISTENTE_MODELO=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ASSISTENTE_MAX_PASSOS=10
ASSISTENTE_MAX_TOKENS=2500
# Memoria curta por conversa no Telegram: quantas trocas e por quantos minutos. 0 desliga.
MEMORIA_TROCAS=10
MEMORIA_MINUTOS=180

# Vigia de logins: confere ML e Tiny nos servicos a cada N minutos e avisa no Telegram quando muda. 0 desliga.
VIGIA_MINUTOS=30

# --- Telegram (os MESMOS do ml-analytics: e o mesmo bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_IDS=
# Endereco publico DESTE servico (o Gerente), usado pra registrar o webhook.
BASE_URL=https://SEU-DOMINIO-GERENTE
