# mcs-gerente v1 — variaveis de ambiente (copie para .env ou cadastre no EasyPanel)

PORT=3020
# Protege /debug/* deste servico. Sem ela as rotas de diagnostico ficam DESLIGADAS.
SERVICE_API_KEY=

# --- os tres sistemas da MCS ---
# URL publica de cada servico + a SERVICE_API_KEY DAQUELE servico.
ANALYTICS_BASE_URL=https://SEU-DOMINIO-ANALYTICS
ANALYTICS_API_KEY=
ACTIONS_BASE_URL=https://tiny-ml-actions.zgbjol.easypanel.host
ACTIONS_API_KEY=
NF_BASE_URL=https://SEU-DOMINIO-TINY-PEDIDOS-NF
NF_API_KEY=
# Espera maxima por sistema (ms) e teto do resultado de uma ferramenta enviado ao modelo.
SISTEMA_TIMEOUT_MS=25000
RESULTADO_MAX_CHARS=12000

# --- assistente (copie os MESMOS valores que estao hoje no ml-analytics) ---
# 'anthropic' | 'openrouter'. Vazio = usa a chave que estiver configurada
# (com as duas presentes, fica com o OpenRouter).
ASSISTENTE_PROVEDOR=
# Na Anthropic pode ficar vazio (escolhe um Sonnet). No OpenRouter e OBRIGATORIO.
ASSISTENTE_MODELO=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ASSISTENTE_MAX_PASSOS=8
ASSISTENTE_MAX_TOKENS=1500

# --- Telegram (os MESMOS do ml-analytics: e o mesmo bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_IDS=
# Endereco publico DESTE servico (o Gerente), usado pra registrar o webhook.
BASE_URL=https://SEU-DOMINIO-GERENTE
